# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paddle (Required for international USD checkout — cliente-side, seguro de exponer)
VITE_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
VITE_PADDLE_ENVIRONMENT=sandbox

# Cloudflare Turnstile — anti-bot en /register (cliente-side, seguro de exponer).
# Sin configurar, el widget no se monta y el registro sigue funcionando igual.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# The following environment variables should be set in Supabase Edge Functions secrets:
# supabase secrets set MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
# supabase secrets set MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
# supabase secrets set OPENAI_API_KEY=your-openai-api-key
# supabase secrets set YCLOUD_API_KEY=your-ycloud-api-key
# supabase secrets set PADDLE_API_KEY=your-paddle-secret-api-key
# supabase secrets set PADDLE_WEBHOOK_SECRET=your-paddle-notification-secret
# supabase secrets set PADDLE_ENVIRONMENT=sandbox
# supabase secrets set PADDLE_CONTAINER_PRODUCT_ID=pro_...
# supabase secrets set TURNSTILE_SECRET_KEY=your-turnstile-secret-key
